{
  "type": "object",
  "title": "Row Configuration",
  "properties": {
    "endpoint": {
      "type": "string",
      "title": "Endpoint",
      "format": "select",
      "enum": [],
      "description": "The Money S3 object to write to (e.g. Company, IssuedInvoice).",
      "propertyOrder": 10,
      "options": {
        "async": {
          "label": "Re-load endpoints",
          "action": "list_endpoints"
        }
      }
    },
    "_load_endpoint_metadata": {
      "type": "button",
      "format": "sync-action",
      "propertyOrder": 11,
      "options": {
        "hidden": true,
        "async": {
          "label": "Load endpoint metadata",
          "action": "get_endpoint_metadata",
          "autoload": ["endpoint"],
          "cache": false
        }
      }
    },
    "write_mode": {
      "type": "string",
      "title": "Write Mode",
      "format": "select",
      "enum": [
        "create",
        "update"
      ],
      "default": "create",
      "propertyOrder": 20,
      "options": {
        "enum_titles": [
          "Create",
          "Update"
        ]
      }
    },
    "key_field": {
      "type": "string",
      "title": "Key Field",
      "default": "guid",
      "description": "Record identifier field used to match existing records for update.",
      "propertyOrder": 30,
      "options": {
        "dependencies": {
          "write_mode": "update"
        }
      }
    },
    "field_mapping": {
      "type": "array",
      "title": "Field Mapping",
      "format": "table",
      "propertyOrder": 40,
      "items": {
        "type": "object",
        "required": [
          "source_column",
          "destination_field"
        ],
        "properties": {
          "source_column": {
            "type": "string",
            "title": "Source Column",
            "options": {
              "readOnly": true
            }
          },
          "destination_field": {
            "type": "string",
            "title": "Destination Field",
            "format": "select",
            "watch": {
              "api_fields": "_metadata_.api_fields"
            },
            "enumSource": [
              {
                "source": "api_fields",
                "value": "{{item.field_name}}",
                "title": "{{item.label}}"
              }
            ],
            "options": {
              "tags": true
            }
          }
        }
      }
    },
    "load_mapping": {
      "type": "button",
      "format": "sync-action",
      "propertyOrder": 50,
      "options": {
        "async": {
          "label": "Re-load mapping",
          "action": "load_field_mapping",
          "autoload": [
            "endpoint"
          ],
          "cache": false
        }
      }
    },
    "_has_line_items_helper": {
      "type": "boolean",
      "propertyOrder": 55,
      "template": "{{val}}",
      "watch": {
        "val": "_metadata_.has_line_items"
      },
      "options": {
        "hidden": true
      }
    },
    "lines_table": {
      "type": "string",
      "title": "Lines Table (destination filename)",
      "description": "Destination filename of the second input table that contains line items. Required for document mode (e.g. invoices with line rows).",
      "propertyOrder": 60,
      "options": {
        "dependencies": {
          "_has_line_items_helper": true
        }
      }
    },
    "lines_join_key": {
      "type": "string",
      "title": "Lines Join Key",
      "description": "Column name that joins header rows to their corresponding line rows.",
      "propertyOrder": 70,
      "options": {
        "dependencies": {
          "_has_line_items_helper": true
        }
      }
    },
    "lines_field_mapping": {
      "type": "array",
      "title": "Lines Field Mapping",
      "format": "table",
      "description": "Field mapping for line items.",
      "propertyOrder": 80,
      "options": {
        "dependencies": {
          "_has_line_items_helper": true
        }
      },
      "items": {
        "type": "object",
        "required": [
          "source_column",
          "destination_field"
        ],
        "properties": {
          "source_column": {
            "type": "string",
            "title": "Source Column",
            "options": {
              "readOnly": true
            }
          },
          "destination_field": {
            "type": "string",
            "title": "Destination Field",
            "format": "select",
            "watch": {
              "line_api_fields": "_metadata_.line_api_fields"
            },
            "enumSource": [
              {
                "source": "line_api_fields",
                "value": "{{item.field_name}}",
                "title": "{{item.label}}"
              }
            ],
            "options": {
              "tags": true
            }
          }
        }
      }
    },
    "batch_size": {
      "type": "integer",
      "title": "Batch Size",
      "default": 100,
      "minimum": 1,
      "maximum": 500,
      "description": "Number of records submitted per batch.",
      "propertyOrder": 90
    },
    "poll_timeout_s": {
      "type": "integer",
      "title": "Import Confirmation Timeout (s)",
      "default": 30,
      "minimum": 0,
      "description": "Seconds to poll Money S3 for each record's final import state. Set to 0 to submit and report immediately — the agenda's S3 Automatic processes the import queue asynchronously.",
      "propertyOrder": 95
    },
    "continue_on_error": {
      "type": "boolean",
      "title": "Continue on Error",
      "format": "checkbox",
      "default": false,
      "description": "When enabled, failed records are written to the write_log output table instead of failing the whole job.",
      "propertyOrder": 100
    },
    "debug": {
      "type": "boolean",
      "title": "Debug",
      "format": "checkbox",
      "default": false,
      "propertyOrder": 110
    },
    "_metadata_": {
      "type": "object",
      "propertyOrder": 120,
      "options": {
        "hidden": true
      },
      "properties": {
        "api_fields": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "line_api_fields": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "has_line_items": {
          "type": "boolean"
        }
      }
    }
  }
}
