  {
    "name": "03_load_field_mapping",
    "description": "Auto-map input columns to the Company endpoint's introspected fields.",
    "config": {
      "action": "load_field_mapping",
      "parameters": {
        "base_url": "http://localhost:28085",
        "scope": "s3api",
        "app_id": "DUMMY_APP_ID",
        "client_id": "DUMMY_CLIENT_ID",
        "#client_secret": "DUMMY_SECRET",
        "endpoint": "Company"
      },
      "storage": {
        "input": {
          "tables": [
            {"destination": "companies.csv", "columns": ["business_name", "email", "identification_number"]}
          ]
        }
      }
    }
  },
  {
    "name": "04_create_company",
    "description": "Create a Company (address-book) record in Money S3 via createCompany (real write).",
    "config": {
      "action": "run",
      "parameters": {
        "base_url": "http://localhost:28085",
        "scope": "s3api",
        "app_id": "DUMMY_APP_ID",
        "client_id": "DUMMY_CLIENT_ID",
        "#client_secret": "DUMMY_SECRET",
        "agenda_id": "70efd056-d613-46f0-97bd-949c9d0989da",
        "endpoint": "Company",
        "write_mode": "create",
        "poll_timeout_s": 0,
        "continue_on_error": true,
        "field_mapping": [
          {"source_column": "business_name", "destination_field": "businessAddress.name"},
          {"source_column": "email", "destination_field": "email"},
          {"source_column": "identification_number", "destination_field": "identificationNumber"}
        ]
      },
      "storage": {
        "input": {
          "tables": [
            {"destination": "companies.csv"}
          ]
        }
      }
    }
  },
