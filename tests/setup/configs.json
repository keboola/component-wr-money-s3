  {
    "name": "05_create_company",
    "description": "Create Company records in Money S3 (async, poll_timeout_s=0 -> UNPROCESSED).",
    "config": {
      "action": "run",
      "parameters": {
        "base_url": "https://kbc-test.api.moneys3.eu",
        "client_id": "DUMMY_CLIENT_ID",
